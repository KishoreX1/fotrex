# Copy these into Vercel -> Project -> Settings -> Environment Variables (Production + Preview).
# Never commit real values.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # secret: used only by api/stripe-webhook.js

# AI (Hive, OpenAI-compatible) - chat / explain / report
HIVE_API_KEY=your_hive_key
HIVE_MODEL=zai-org/glm-5.3-flash

# Stripe (optional - only needed for paid plans)
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_SITE_URL=https://your-domain.vercel.app
